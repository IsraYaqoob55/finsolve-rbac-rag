# Copy this file to .env and fill in real values. Never commit .env.

# --- App ---
APP_NAME="FinSolve RBAC RAG"
APP_ENV=development          # development | staging | production
LOG_LEVEL=INFO
LOG_JSON=false               # true = JSON logs (for production log collectors)

# --- Paths ---
DATA_DIR=data
ROLES_CONFIG=config/roles.yaml

# --- LLM (Phase 3) ---
LLM_PROVIDER=groq            # groq | openai | ollama (any OpenAI-compatible API)
LLM_MODEL=openai/gpt-oss-120b
LLM_REASONING_EFFORT=low       # only for reasoning models; leave empty otherwise
LLM_BASE_URL=                # optional: override the provider's endpoint
LLM_API_KEY=

# --- Auth (Phase 2) ---
# Generate a real secret with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=60
USER_DB_PATH=var/users.db
# Password for the demo users created by `python -m app.auth.manage seed`
SEED_USER_PASSWORD=FinSolveDemo@2024

# --- Vector store (Phase 1) ---
# Leave QDRANT_URL empty to run Qdrant embedded (data stored in QDRANT_PATH).
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_PATH=qdrant_storage
QDRANT_COLLECTION=finsolve_docs

# --- Embeddings & chunking (Phase 1) ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CHUNK_MAX_CHARS=1500
CHUNK_OVERLAP_CHARS=200

# --- Retrieval quality (Phase 5) ---
SPARSE_MODEL=Qdrant/bm25
RERANKER_MODEL=jinaai/jina-reranker-v1-turbo-en
RETRIEVAL_HYBRID=true          # dense + BM25 keyword search, fused with RRF
RETRIEVAL_QUARTER_BOOST=true   # favour chunks from quarters named in the question
RETRIEVAL_RERANK=true          # cross-encoder re-scores the candidates
RETRIEVAL_CANDIDATES=10
QUERY_REWRITE=true             # rewrite follow-ups ("and Q4?") into standalone searches

# --- Structured data / SQL (Phase 6) ---
SQL_ENABLED=true
DATASETS_CONFIG=config/datasets.yaml
SQL_MAX_ROWS=200
SQL_TIMEOUT_SECONDS=2

# --- Production hardening (Phase 8) ---
AUDIT_LOG_PATH=var/audit.log      # JSON-lines audit trail; empty = disabled
AUDIT_INCLUDE_QUESTIONS=true      # false = store "[redacted]" instead of question text
RATE_LIMIT_CHAT_PER_MINUTE=20     # per user, for /chat, /chat/stream and /search; 0 = off
RATE_LIMIT_LOGIN_PER_MINUTE=10    # per username + client address; 0 = off
LLM_HELPER_MODEL=openai/gpt-oss-20b  # smaller model for follow-up rewriting; empty = main model
